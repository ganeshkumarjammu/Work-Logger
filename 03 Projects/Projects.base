filters:
  and:
    - 'type == "project"'
    - not:
        - 'file.inFolder("90 Templates")'
properties:
  file.name:
    displayName: Project
  status:
    displayName: Status
  next_action:
    displayName: Next action
  actual_mins:
    displayName: Time on home note (min)
views:
  - type: table
    name: Active
    filters:
      and:
        - 'status != "done"'
    order:
      - file.name
      - status
      - owner
      - due
      - next_action
  - type: table
    name: All
    order:
      - file.name
      - status
      - start
      - due
